<!DOCTYPE html>
<!--
  ════════════════════════════════════════════════════════════════════
  OwnYourCode SDD Template — mission.html
  ════════════════════════════════════════════════════════════════════
  Purpose: Project-level vision. Problem, audience, definition of done.
  Generated by: /own:init (Phase 6)
  Read by:      Humans (Daniel and users referencing project intent).

  SEMANTIC CONTRACT:
    • <body data-document-type="mission"> — file identity for command validation
    • Definition-of-Done items use <div class="dod-item" data-dod-id="X">
        with a checkbox + label. Distinct from data-task-id (which is
        feature-level) so /own:done never accidentally mutates project DoD.
  ════════════════════════════════════════════════════════════════════
-->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{PROJECT_NAME}} — Mission</title>
  <link rel="stylesheet" href="../.theme/theme.css" />
</head>
<body data-document-type="mission">

  <header class="document-header">
    <p class="document-eyebrow">Project Mission</p>
    <h1>{{PROJECT_NAME}}</h1>
    <p class="document-meta">Generated: {{ISO_DATE}}</p>
  </header>

  <main>

    <section class="mission-section" data-section="problem">
      <h2>The Problem</h2>
      <p>{{PROBLEM_STATEMENT}}</p>
    </section>

    <section class="mission-section" data-section="audience">
      <h2>Who Is This For?</h2>
      <p>{{AUDIENCE}}</p>
    </section>

    <section class="mission-section" data-section="definition-of-done">
      <h2>Definition of Done</h2>
      <p class="section-intro">When these things work, the project is COMPLETE:</p>

      <!-- DoD items use data-dod-id (NOT data-task-id) to prevent
           accidental cross-file mutation by /own:done -->
      <div class="dod-item" data-dod-id="1" data-status="pending">
        <input type="checkbox" aria-label="{{DOD_ITEM_1}}" />
        <span class="dod-text">{{DOD_ITEM_1}}</span>
      </div>

      <div class="dod-item" data-dod-id="2" data-status="pending">
        <input type="checkbox" aria-label="{{DOD_ITEM_2}}" />
        <span class="dod-text">{{DOD_ITEM_2}}</span>
      </div>

      <div class="dod-item" data-dod-id="3" data-status="pending">
        <input type="checkbox" aria-label="{{DOD_ITEM_3}}" />
        <span class="dod-text">{{DOD_ITEM_3}}</span>
      </div>
    </section>

    <section class="mission-section" data-section="why">
      <h2>Why This Matters</h2>
      <p>{{WHY_THIS_MATTERS}}</p>
    </section>

  </main>

  <footer class="document-footer">
    <p>OwnYourCode v{{VERSION}} — <a href="../README.md">about</a></p>
  </footer>

</body>
</html>
