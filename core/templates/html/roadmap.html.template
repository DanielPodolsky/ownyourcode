<!DOCTYPE html>
<!--
  ════════════════════════════════════════════════════════════════════
  OwnYourCode SDD Template — roadmap.html
  ════════════════════════════════════════════════════════════════════
  Purpose: Phased development plan for the entire project.
  Generated by: /own:init
  Read by:      /own:feature (finds first data-status="incomplete" phase
                              for auto-detection of next phase to spec)

  SEMANTIC CONTRACT (do not modify; /own:feature depends on these attributes):
    • <body data-document-type="roadmap"> — validates the file before read
    • <section class="phase"
        data-phase-number="N"
        data-phase-name="slug"
        data-status="incomplete|complete">
        — each phase MUST have number, name slug, and status

  /own:feature phase-detection logic (no HTML parser — text scan only):
    1. Read roadmap.html
    2. Find first occurrence of: data-status="incomplete"
    3. Extract data-phase-number and data-phase-name from same section
    4. Create folder: ownyourcode/specs/active/phase-{number}-{name-slug}/

  Phase items use <li data-roadmap-item="X.Y"> for human readability —
  these are not mutated by commands. The phase data-status is updated
  manually when all items in a phase complete (handled by /own:done's
  6-Gates flow at phase boundary).
  ════════════════════════════════════════════════════════════════════
-->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{PROJECT_NAME}} — Roadmap</title>
  <link rel="stylesheet" href="../.theme/theme.css" />
</head>
<body data-document-type="roadmap">

  <header class="document-header">
    <p class="document-eyebrow">Project Roadmap</p>
    <h1>{{PROJECT_NAME}}</h1>
    <p class="document-meta">Generated: {{ISO_DATE}}</p>
  </header>

  <main>

    <p class="roadmap-intro">{{INTRO_PARAGRAPH}}</p>

    <!-- ============================================================
         PHASE BLOCKS: ordered top-to-bottom.
         /own:feature finds the FIRST data-status="incomplete" phase.
         When all items in a phase complete, mark the phase data-status
         to "complete" so the next phase becomes eligible.
         ============================================================ -->

    <section class="phase" data-phase-number="1" data-phase-name="foundation" data-status="incomplete">
      <h2>Phase 1: Foundation</h2>
      <p class="phase-priority" data-priority="high">Priority: HIGH</p>
      <p class="phase-description">{{PHASE_1_DESCRIPTION}}</p>
      <ul class="phase-items">
        <li data-roadmap-item="1.1">Project structure scaffolded</li>
        <li data-roadmap-item="1.2">Core dependencies installed</li>
        <li data-roadmap-item="1.3">Development environment verified</li>
      </ul>
    </section>

    <section class="phase" data-phase-number="2" data-phase-name="core-features" data-status="incomplete">
      <h2>Phase 2: Core Features</h2>
      <p class="phase-priority" data-priority="medium">Priority: MEDIUM</p>
      <p class="phase-description">{{PHASE_2_DESCRIPTION}}</p>
      <ul class="phase-items">
        <li data-roadmap-item="2.1">{{CORE_FEATURE_1}}</li>
        <li data-roadmap-item="2.2">{{CORE_FEATURE_2}}</li>
      </ul>
    </section>

    <section class="phase" data-phase-number="3" data-phase-name="polish" data-status="incomplete">
      <h2>Phase 3: Polish &amp; Deploy</h2>
      <p class="phase-priority" data-priority="low">Priority: LOW</p>
      <p class="phase-description">Testing, documentation, deployment.</p>
      <ul class="phase-items">
        <li data-roadmap-item="3.1">Testing and bug fixes</li>
        <li data-roadmap-item="3.2">Documentation polished</li>
        <li data-roadmap-item="3.3">Deployment ready</li>
      </ul>
    </section>

  </main>

  <footer class="document-footer">
    <p>OwnYourCode v{{VERSION}} — <a href="../README.md">about</a></p>
  </footer>

</body>
</html>
