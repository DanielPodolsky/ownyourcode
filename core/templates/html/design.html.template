<!DOCTYPE html>
<!--
  ════════════════════════════════════════════════════════════════════
  OwnYourCode SDD Template — design.html
  ════════════════════════════════════════════════════════════════════
  Purpose: Technical software design — architecture, data flow,
           component breakdown, trade-offs. NOT UI mockups.
  Generated by: /own:feature (Phase 2: design creation)
  Read by:      Humans (review), /own:guide (architecture context).

  EXPLICIT NON-GOAL:
    This template does NOT support Thariq's "4 UI layouts" pattern.
    SDD design.md (now design.html) is for SOFTWARE architecture —
    data flow, components, decisions. UI mocking is a separate future
    feature (potentially /own:mockup).

  SEMANTIC CONTRACT:
    • <body data-document-type="design"> — file identity
    • <section class="design-section" data-section="name"> — content
    • Trade-offs use <article class="trade-off" data-trade-off-id="X">
        with chosen + rejected options for clarity.
    • Open questions use <li data-question-id="X"> for referenceability.
  ════════════════════════════════════════════════════════════════════
-->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{FEATURE_TITLE}} — Technical Design</title>
  <link rel="stylesheet" href="../../../.theme/theme.css" />
</head>
<body data-document-type="design" data-phase-number="{{PHASE_N}}" data-phase-name="{{PHASE_SLUG}}">

  <header class="document-header">
    <p class="document-eyebrow">Phase {{PHASE_N}} — {{PHASE_NAME}} — Technical Design</p>
    <h1>{{FEATURE_TITLE}}</h1>
    <p class="document-meta">Generated: {{ISO_DATE}}</p>
  </header>

  <main>

    <section class="design-section" data-section="architecture-overview">
      <h2>Architecture Overview</h2>
      <p>{{ARCHITECTURE_OVERVIEW}}</p>
      <figure class="architecture-diagram">
        <pre data-diagram-type="ascii">{{ARCHITECTURE_DIAGRAM}}</pre>
        <figcaption>{{DIAGRAM_CAPTION}}</figcaption>
      </figure>
    </section>

    <section class="design-section" data-section="data-flow">
      <h2>Data Flow</h2>
      <p>{{DATA_FLOW_DESCRIPTION}}</p>
      <ol class="data-flow-steps">
        <li data-flow-step="1">{{FLOW_STEP_1}}</li>
        <li data-flow-step="2">{{FLOW_STEP_2}}</li>
        <li data-flow-step="3">{{FLOW_STEP_3}}</li>
      </ol>
    </section>

    <section class="design-section" data-section="component-breakdown">
      <h2>Component Breakdown</h2>
      <table class="component-table">
        <thead>
          <tr><th scope="col">Component</th><th scope="col">Responsibility</th><th scope="col">Owns</th></tr>
        </thead>
        <tbody>
          <tr data-component="{{COMPONENT_1_NAME}}">
            <td><code>{{COMPONENT_1_NAME}}</code></td>
            <td>{{COMPONENT_1_RESPONSIBILITY}}</td>
            <td>{{COMPONENT_1_OWNS}}</td>
          </tr>
          <tr data-component="{{COMPONENT_2_NAME}}">
            <td><code>{{COMPONENT_2_NAME}}</code></td>
            <td>{{COMPONENT_2_RESPONSIBILITY}}</td>
            <td>{{COMPONENT_2_OWNS}}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="design-section" data-section="trade-offs">
      <h2>Trade-offs &amp; Decisions</h2>

      <article class="trade-off" data-trade-off-id="1">
        <h3>{{TRADE_OFF_1_TITLE}}</h3>
        <p class="trade-off-context">{{TRADE_OFF_1_CONTEXT}}</p>
        <p class="trade-off-chosen"><strong>Chosen:</strong> {{TRADE_OFF_1_CHOSEN}}</p>
        <p class="trade-off-rejected"><strong>Rejected:</strong> {{TRADE_OFF_1_REJECTED}}</p>
        <p class="trade-off-reasoning"><strong>Why:</strong> {{TRADE_OFF_1_REASONING}}</p>
      </article>

      <article class="trade-off" data-trade-off-id="2">
        <h3>{{TRADE_OFF_2_TITLE}}</h3>
        <p class="trade-off-context">{{TRADE_OFF_2_CONTEXT}}</p>
        <p class="trade-off-chosen"><strong>Chosen:</strong> {{TRADE_OFF_2_CHOSEN}}</p>
        <p class="trade-off-rejected"><strong>Rejected:</strong> {{TRADE_OFF_2_REJECTED}}</p>
        <p class="trade-off-reasoning"><strong>Why:</strong> {{TRADE_OFF_2_REASONING}}</p>
      </article>
    </section>

    <section class="design-section" data-section="file-structure">
      <h2>File Structure</h2>
      <pre data-file-tree="proposed">{{FILE_TREE}}</pre>
    </section>

    <section class="design-section" data-section="open-questions">
      <h2>Open Questions</h2>
      <p class="section-intro">Decisions deferred until implementation:</p>
      <ul class="open-questions">
        <li data-question-id="1">{{QUESTION_1}}</li>
      </ul>
    </section>

  </main>

  <footer class="document-footer">
    <nav class="spec-nav">
      <a href="./spec.html">← Specification</a>
      <a href="./tasks.html">→ Implementation Tasks</a>
    </nav>
    <p>OwnYourCode v{{VERSION}} — <a href="../../../README.md">about</a></p>
  </footer>

</body>
</html>
