<!DOCTYPE html>
<!--
  ════════════════════════════════════════════════════════════════════
  OwnYourCode SDD Template — tasks.html
  ════════════════════════════════════════════════════════════════════
  Purpose: Phased implementation checklist for a feature.
  Generated by: /own:feature
  Mutated by:   /own:done   (sets data-status="completed", adds `checked`)
  Read by:      /own:status (counts data-status="completed" vs total)

  SEMANTIC CONTRACT (do not modify; commands depend on these attributes):
    • <body data-document-type="tasks"> — validates the file before mutation
    • <div class="task" data-task-id="X.Y" data-status="pending|completed">
        — each task MUST have unique data-task-id and a data-status
    • <input type="checkbox" aria-label="<task-text>">
        — aria-label gives Edit-tool a unique anchor per task

  /own:done mutation (exact-string Edit):
    Before:  data-task-id="1.1" data-status="pending"
    After:   data-task-id="1.1" data-status="completed"
    Before:  <input type="checkbox" aria-label="Install dependencies" />
    After:   <input type="checkbox" checked aria-label="Install dependencies" />

  /own:status counting (no parsing — just text count):
    Total tasks    = count of   data-task-id="
    Completed      = count of   data-status="completed"
    Progress %     = (completed / total) * 100
  ════════════════════════════════════════════════════════════════════
-->
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{FEATURE_TITLE}} — Tasks</title>
  <link rel="stylesheet" href="../../../.theme/theme.css" />
</head>
<body data-document-type="tasks" data-phase-number="{{PHASE_N}}" data-phase-name="{{PHASE_SLUG}}">

  <header class="document-header">
    <p class="document-eyebrow">Phase {{PHASE_N}} — {{PHASE_NAME}}</p>
    <h1>{{FEATURE_TITLE}} — Tasks</h1>
    <p class="document-meta">Generated: {{ISO_DATE}}</p>
  </header>

  <main>

    <!-- ============================================================
         PHASE GROUP: organize tasks into logical sub-sections.
         Each group has a heading; tasks live as direct children.
         Add more phase-groups as needed. Maintain data-task-id uniqueness.
         ============================================================ -->

    <section class="phase-group" data-phase-segment="setup">
      <h2>Setup</h2>

      <!-- CANONICAL TASK BLOCK — copy this structure for every task -->
      <div class="task" data-task-id="1.1" data-status="pending">
        <input type="checkbox" aria-label="Install dependencies" />
        <span class="task-text">Install dependencies</span>
      </div>

      <div class="task" data-task-id="1.2" data-status="pending">
        <input type="checkbox" aria-label="Configure environment variables" />
        <span class="task-text">Configure environment variables</span>
      </div>
    </section>

    <section class="phase-group" data-phase-segment="implementation">
      <h2>Implementation</h2>

      <div class="task" data-task-id="2.1" data-status="pending">
        <input type="checkbox" aria-label="Build core feature logic" />
        <span class="task-text">Build core feature logic</span>
      </div>

      <div class="task" data-task-id="2.2" data-status="pending">
        <input type="checkbox" aria-label="Wire UI to logic" />
        <span class="task-text">Wire UI to logic</span>
      </div>
    </section>

    <section class="phase-group" data-phase-segment="verification">
      <h2>Verification</h2>

      <div class="task" data-task-id="3.1" data-status="pending">
        <input type="checkbox" aria-label="Write tests covering edge cases" />
        <span class="task-text">Write tests covering edge cases</span>
      </div>

      <div class="task" data-task-id="3.2" data-status="pending">
        <input type="checkbox" aria-label="Run /own:done with 6-Gates review" />
        <span class="task-text">Run /own:done with 6-Gates review</span>
      </div>
    </section>

  </main>

  <footer class="document-footer">
    <p>OwnYourCode v{{VERSION}} — <a href="../../../README.md">about</a></p>
  </footer>

</body>
</html>
