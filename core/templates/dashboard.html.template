  const gstats = groups.map(g=>{ const gt=p.tasks.filter(t=>t.group===g); const gd=gt.filter(t=>t.done).length;
    return `<div class='gst'><div class='gn'>${gd}/${gt.length}</div><div class='gl'>${esc(g)}</div></div>`; }).join("");
  const ring = `<div class="ring-wrap"><svg class="ring" viewBox="0 0 36 36">
      <circle class="bgc" cx="18" cy="18" r="15.9" pathLength="100"></circle>
